#!/usr/bin/env bash
# Convenience wrapper for driving the pet during development.
#
#   scripts/pet start          (re)launch the pet — does NOT rebuild, so the
#                              Accessibility grant survives
#   scripts/pet rebuild        recompile, re-bundle and relaunch (may drop the
#                              Accessibility grant — re-approve if so)
#   scripts/pet stop           kill it
#   scripts/pet restart        same as start
#   scripts/pet <state>        push a state: idle launch racing boost
#                              waiting victory crash
#   scripts/pet test           run the test suite
#   scripts/pet coverage       run tests under coverage and refresh the badge
#   scripts/pet probe          print the Dock geometry it resolved
#   scripts/pet sprite [path]  export a magnified PNG of the car
set -euo pipefail

# Resolve symlinks before working out the repo root, so this still finds the
# project when invoked through a symlink on PATH (e.g. ~/.local/bin/pet).
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [ "${SOURCE:0:1}" = "/" ] || SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

BIN="$ROOT/.build/debug/F1DockPet"
APP="$ROOT/F1DockPet.app"

build() { (cd "$ROOT" && swift build); }
stop()  { pkill -f 'F1DockPet' 2>/dev/null || true; sleep 0.3; }

# Fully detach: nohup + closed stdio + disown. Without all three the pet stays
# in the caller's process group, so anything that kills the calling shell — a
# tool timeout, closing the terminal — takes the pet down with it.
# Launch the .app rather than the bare binary: macOS refuses to display a menu
# bar status item for an unbundled process.
#
# Deliberately does NOT rebuild. The app is ad-hoc signed, so rebuilding changes
# its code identity and macOS silently revokes its Accessibility grant — which
# is what lets the pet track the Dock exactly. Use `pet rebuild` when you have
# actually changed the code, and expect to re-approve it afterwards.
start() {
    [ -d "$APP" ] || "$ROOT/scripts/build-app.sh" >/dev/null
    stop
    open -a "$APP"
    sleep 1
    echo "pet running (pid $(pgrep -f F1DockPet | head -1))"
}

rebuild() {
    "$ROOT/scripts/build-app.sh" >/dev/null
    stop
    open -a "$APP"
    sleep 1
    echo "pet rebuilt and running (pid $(pgrep -f F1DockPet | head -1))"
    echo "note: rebuilding re-signs the app, so macOS may have dropped its"
    echo "      Accessibility grant. Re-tick F1DockPet in System Settings →"
    echo "      Privacy & Security → Accessibility if the car stops tracking"
    echo "      the Dock exactly."
}

case "${1:-start}" in
  start)   start ;;
  stop)    stop; echo "pet stopped" ;;
  restart) start ;;
  rebuild) rebuild ;;
  test)    build; "$BIN" --self-test ;;
  coverage) "$ROOT/scripts/coverage" "${2:---badge}" ;;
  probe)   build; "$BIN" --probe ;;
  sprite)  build; "$BIN" --export-sprite "${2:-/tmp/rb22.png}" ;;
  idle|launch|racing|boost|waiting|victory|spin|crash)
           "$BIN" --notify "$1" ;;
  *)       sed -n '2,12p' "${BASH_SOURCE[0]}"; exit 2 ;;
esac
